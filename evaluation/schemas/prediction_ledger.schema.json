{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-share Prediction Ledger Record",
  "type": "object",
  "required": ["prediction_id", "task", "created_at", "information_cutoff", "model_version", "rule_version", "forecast", "confidence"],
  "properties": {
    "prediction_id": {"type": "string", "minLength": 1},
    "task": {"enum": ["basic_market", "ai_sector"]},
    "created_at": {"type": "string", "format": "date-time"},
    "information_cutoff": {"type": "string", "format": "date-time"},
    "model_version": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "data_version": {"type": "string"},
    "market_regime": {"type": "string"},
    "forecast": {
      "type": "object",
      "required": ["t1", "t3", "t5"],
      "properties": {
        "t1": {"type": "string"},
        "t3": {"type": "string"},
        "t5": {"type": "string"}
      },
      "additionalProperties": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_snapshot": {"type": "string"}
  },
  "additionalProperties": true
}
